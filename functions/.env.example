# Copy to functions/.env and fill in. functions/.env is gitignored: it
# names your Cloud Run endpoint, service account and buckets, which are
# deployment details rather than code.
WORKER_URL=https://job-engine-worker-<project-number>.us-central1.run.app
WORKER_INVOKER_SA=task-invoker@<your-project-id>.iam.gserviceaccount.com
TASKS_QUEUE=submissions
TASKS_LOCATION=us-central1
# Bucket the resume-upload trigger watches — must match the bucket the web
# app uploads to (NEXT_PUBLIC_FB_STORAGE_BUCKET in web/.env.local), and the
# trigger must be deployed in the bucket's region (Eventarc requirement).
STORAGE_BUCKET=<your-project-id>.firebasestorage.app
STORAGE_REGION=us-east1

# --- Models -----------------------------------------------------------
# Default is claude-sonnet-5 (shared/llm.py). These roles run on Haiku 4.5
# at half the price: high volume, low judgement, nothing irreversible.
LLM_MODEL_MATCHING=claude-haiku-4-5
LLM_MODEL_EXTRACT=claude-haiku-4-5
LLM_MODEL_DISCOVERY=claude-haiku-4-5
LLM_MODEL_JUDGE=claude-haiku-4-5
LLM_MODEL_SYNONYMS=claude-haiku-4-5
LLM_MODEL_METRO=claude-haiku-4-5
LLM_MODEL_TRACK=claude-haiku-4-5

# Autonomous submission. Off by default — see functions/main.py.
# AUTO_SUBMIT=true
